[Desktop Entry]
Type=Application
Name=Inanna
GenericName=Presentation
Comment=Create and present slide decks
Exec=inanna %F
TryExec=inanna
Icon=io.github.tomblanchard312.Inanna
Terminal=false
StartupNotify=true
StartupWMClass=io.github.tomblanchard312.Inanna
Categories=Office;Presentation;
MimeType=application/x-deckcraft;application/vnd.openxmlformats-officedocument.presentationml.presentation;application/vnd.openxmlformats-officedocument.presentationml.template;application/vnd.openxmlformats-officedocument.presentationml.slideshow;
Keywords=presentation;slides;slide show;deck;pptx;keynote;powerpoint;
